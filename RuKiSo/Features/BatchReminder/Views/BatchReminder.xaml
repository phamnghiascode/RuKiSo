<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="RuKiSo.UI.Views.BatchReminder"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Frame
        Margin="20"
        Padding="20"
        BackgroundColor="White"
        CornerRadius="10"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="15">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Batch Reminders" />

            <CollectionView ItemsSource="{Binding Batches}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" RowDefinitions="Auto,Auto,Auto">
                            <Label FontAttributes="Bold" Text="{Binding Product.Name}" />
                            <Label Grid.Row="1" Text="{Binding EstimateEndDate, StringFormat='End Date: {0:d}'}" />
                            <Label Grid.Row="2" Text="{Binding Yield, StringFormat='Expected Yield: {0}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Command="{Binding CloseCommand}"
                HorizontalOptions="Center"
                Text="Close" />
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>